# --- MongoDB Configuration ---
# Default: MongoDB Atlas cluster
# To switch to the local containerized MongoDB, set to:
# USER_PROFILE_MONGODB_URI=mongodb://mongodb:27017/user_profile_db
# FOOD_DB_MONGODB_URI=mongodb://mongodb:27017/food_database
# MEAL_PLANNING_MONGODB_URI=mongodb://mongodb:27017/food_database
# GROCERY_PLANNING_MONGODB_URI=mongodb://mongodb:27017/grocery_planning_db
USER_PROFILE_MONGODB_URI=mongodb+srv://chatgpt2:riten13@cluster0.ioo4yf3.mongodb.net/user_profile_db?appName=Cluster0
FOOD_DB_MONGODB_URI=mongodb+srv://chatgpt2:riten13@cluster0.ioo4yf3.mongodb.net/food_database?appName=Cluster0
MEAL_PLANNING_MONGODB_URI=mongodb+srv://chatgpt2:riten13@cluster0.ioo4yf3.mongodb.net/food_database?appName=Cluster0
GROCERY_PLANNING_MONGODB_URI=mongodb+srv://chatgpt2:riten13@cluster0.ioo4yf3.mongodb.net/grocery_planning_db?appName=Cluster0

# --- Frontend Configuration ---
# API Gateway entry point accessed by the browser
VITE_API_BASE_URL=http://localhost:8088
