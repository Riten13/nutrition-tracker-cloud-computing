# =============================================================================
# Nutrition Tracker MSA — Environment Variables Template
# Copy this file to .env (do NOT commit .env with real credentials to git):
#   cp .env.example .env
# =============================================================================

# --- MongoDB Atlas Connection Strings ---
# Provide your MongoDB Atlas cluster connection strings (one database per microservice)
USER_PROFILE_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxxx.mongodb.net/user_profile_db?appName=Cluster0
FOOD_DB_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxxx.mongodb.net/food_database?appName=Cluster0
MEAL_PLANNING_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxxx.mongodb.net/food_database?appName=Cluster0
GROCERY_PLANNING_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxxx.mongodb.net/grocery_planning_db?appName=Cluster0

# --- JWT Authentication Secret ---
# Shared secret for signing and validating JWT tokens (min 256 bits / 32 bytes)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here

# --- AWS S3 Food Image Storage Configuration ---
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=nutrition-tracker-food-images-2026-new

# --- Deployment Specific Settings ---
# 1. LOCAL DEVELOPMENT (docker-compose.yml):
#    - VITE_API_BASE_URL=http://localhost:8088
#    - AWS_PROFILE=nutrition-dev (reads ~/.aws on host)
#
# 2. UBUNTU EC2 PRODUCTION (docker-compose.prod.yml):
#    - VITE_API_BASE_URL= (empty: frontend uses same-origin relative URLs via Nginx reverse proxy)
#    - AWS_PROFILE= (empty: AWS SDK automatically uses EC2 IAM Role NutritionTrackerEC2Role via IMDSv2)
VITE_API_BASE_URL=
AWS_PROFILE=
